{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [{ "type": "host", "value": "www.nouryahperfumes.com" }],
      "destination": "https://nouryahperfumes.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/fragrance/:id", "destination": "/index.html" },
    { "source": "/collection", "destination": "/index.html" },
    { "source": "/the-house", "destination": "/index.html" },
    { "source": "/fragrance-finder", "destination": "/index.html" },
    { "source": "/order-request", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/order-confirmed", "destination": "/index.html" },
    { "source": "/track", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<sub>.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
